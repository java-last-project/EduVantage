		<id property="no" column="NO"/>
		<result property="title" column="TITLE"/>
		<result property="image" column="IMAGE"/>
		<result property="answer" column="ANSWER"/>
		<result property="score" column="SCORE"/>
		<result property="description" column="DESCRIPTION"/>
		<result property="type" column="TYPE"/>
		<result property="theme" column="THEME"/>
		<result property="difficulty" column="DIFFICULTY"/>

		<association property="ovo" javaType="com.sist.web.domain.exam.vo.ExamOptionVO">
			<id property="no" column="OPTION_NO"/>
			<result property="question_no" column="QUESTION_NO"/>
			<result property="option1" column="OPTION1"/>
			<result property="option2" column="OPTION2"/>
			<result property="option3" column="OPTION3"/>
			<result property="option4" column="OPTION4"/>
		</association>
	</resultMap>

