	<select id="examDetailData" resultMap="questionMap" parameterType="hashmap">
		SELECT q.no,q.title,q.image,q.answer,o.option1,o.option2,o.option3,o.option4,q.type,q.theme,q.score
		FROM (
			SELECT *
			FROM EXAM_QUESTION
			    <choose>
					<when test="exam_no!=null and exam_no!=0">
						WHERE no IN(
						    SELECT question_no
						    FROM SCHEDULED_EXAM_MAP
						    WHERE exam_no=#{exam_no}
						)
					</when>
					<otherwise>
						WHERE theme=#{theme}
						ORDER BY DBMS_RANDOM.VALUE
					</otherwise>
				</choose>
			) q
			LEFT JOIN EXAM_OPTION o ON q.no=o.question_no
			<if test="exam_no==null or exam_no==0">
				WHERE ROWNUM &lt;= #{count}
			</if>
			ORDER BY q.no
	</select>
	
	<insert id="insertEnrollment" parameterType="com.sist.web.domain.exam.vo.ExamEnrollmentVO"
	        useGeneratedKeys="true" keyProperty="no" keyColumn="no">
	    INSERT INTO exam_enrollment
	    <trim prefix="(" suffix=")" suffixOverrides=",">
	        member_id,
	        starttime,
	        <if test="theme != null and theme != 0">
	            theme,
	        </if>
	        <if test="exam_no != null and exam_no != 0">
	            exam_no,
	        </if>
	    </trim>
	    <trim prefix="VALUES (" suffix=")" suffixOverrides=",">
	        #{member_id},
	        #{starttime},
	        <if test="theme != null and theme != 0">
	            #{theme},
	        </if>
	        <if test="exam_no != null and exam_no != 0">
	            #{exam_no},
	        </if>
	    </trim>
	</insert>

	<select id="getScheduledExamTitle" parameterType="int" resultType="string">
		SELECT title
		FROM SCHEDULED_EXAM
		WHERE no=#{examNo}
	</select>

	<update id="setExamEndTime" parameterType="int">
		UPDATE EXAM_ENROLLMENT
		SET endtime=SYSTIMESTAMP
		WHERE no=#{no}
	</update>

	<insert id="userAnswerInput" parameterType="com.sist.web.domain.exam.vo.ExamUserAnswerVO">
		INSERT INTO EXAM_USER_ANSWER (ENROLLMENT_NO, QUESTION_NO, USER_ANSWER)
		VALUES(#{enrollment_no},#{question_no},#{user_answer})
	</insert>

	<select id="getQuestionAnswer" parameterType="int" resultType="string">
		SELECT answer
		FROM EXAM_QUESTION
		WHERE no=#{question_no}
	</select>


</mapper>